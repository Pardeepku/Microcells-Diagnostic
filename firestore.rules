rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog collections
    match /tests/{testId} {
      allow read: if true;
      allow write: if true;
    }

    match /healthPackages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // Patient booking appointments
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Patient diagnostic reports
    match /patientReports/{uhid} {
      allow read, write: if true;
    }

    // Site settings, banners, CMS configuration
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Admin user profiles
    match /adminUsers/{userId} {
      allow read, write: if true;
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
